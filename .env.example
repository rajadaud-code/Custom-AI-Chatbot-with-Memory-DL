# Project 1: Custom AI Chatbot with Memory - Environment Configuration

# Frontier LLM API Keys (Provide at least one for live API calls)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Active Provider: "gemini", "openai", or "mock" (Default: "mock" if no key is provided)
LLM_PROVIDER=mock

# Model Configurations
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Memory Sliding Window Settings
MAX_MEMORY_MESSAGES=10

# PostgreSQL Database Configuration (Enterprise Architecture Demo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
